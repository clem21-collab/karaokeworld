# KaraokeWorld Sync Server — Google Drive OAuth automatique
# Ne mets jamais de vraies valeurs secrètes dans GitHub.

KW_FRONTEND_ORIGIN=https://clem21-collab.github.io
KW_FIREBASE_PROJECT_ID=karaokeworld-d503f

# Client OAuth 2.0 de type « Application Web » dans Google Cloud.
KW_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
KW_GOOGLE_CLIENT_SECRET=CHANGE_ME

# URL publique HTTPS exacte du callback du serveur.
# Exemple : https://ton-serveur.example.com/google/oauth/callback
KW_GOOGLE_REDIRECT_URI=https://CHANGE_ME/google/oauth/callback

# Deux secrets longs et aléatoires. Ne jamais les exposer dans le navigateur.
KW_TOKEN_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_SECRET
KW_STATE_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET

# Utilise un chemin situé sur un disque persistant chez l'hébergeur.
KW_TOKEN_DB_PATH=./karaokeworld_oauth.sqlite3
